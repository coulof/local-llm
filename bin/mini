#!/bin/bash
# mini — quick generic chat. Ministral-3-8B-Instruct-2512, Q5_K_M.
set -euo pipefail

BACKEND="${LLM_BACKEND:-llama}"

if [[ "$BACKEND" == "mlx" ]]; then
  MINI_MLX_MODEL="${MINI_MLX_MODEL:-mlx-community/Ministral-3-8B-Instruct-2512-4bit}"
  exec "$(dirname "$0")/chat-mlx" "$MINI_MLX_MODEL" "$@"
else
  MODEL_DIR="${MODEL_DIR:-${HOME}/lab/llm/models}"
  MODEL_FILE="${MODEL_DIR}/mistralai_Ministral-3-8B-Instruct-2512-Q5_K_M.gguf"
  if [[ ! -f "$MODEL_FILE" ]]; then
    echo "Error: Model file not found at $MODEL_FILE" >&2
    echo "Please download it first with: ./pull-models.sh" >&2
    exit 1
  fi
  exec llama-cli \
    -m "$MODEL_FILE" \
    -ngl 99 \
    -c 16384 \
    --temp 0.3 --top-p 0.9 \
    "$@"
fi
